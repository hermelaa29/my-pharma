// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User role enum: ADMIN (max 2) or COWORKER (unlimited)
enum Role {
  ADMIN
  COWORKER
}

// User model for authentication and role-based permissions
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  role           Role     @default(COWORKER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stores         Store[]  @relation("StoreCreatedBy")
  assignedStores Store[]  @relation("StoreAssignments")

  @@map("users")
}

// Store model for individual pharmacy locations
model Store {
  id          String   @id @default(uuid())
  name        String
  address     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User     @relation("StoreCreatedBy", fields: [createdById], references: [id])
  createdById String

  coworkers   User[]   @relation("StoreAssignments")
  medicines   Medicine[]
  cosmetics   Cosmetic[]

  @@map("stores")
}

// Medicine model for tracking pharmacy inventory
model Medicine {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  
  itemCode         String
  itemName         String
  receivedDate     DateTime?
  category         String?
  wholesaler       String?
  quantityReceived Int      @default(0)
  quantityIssued   Int      @default(0)
  lossAdjustment   Int      @default(0)
  currentQuantity  Int      @default(0)
  expireDate       DateTime?
  batchNumber      String?
  purchasePrice    Float    @default(0)
  salePrice        Float    @default(0)
  remark           String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("medicines")
}

// Cosmetic model for tracking retail and beauty inventory
model Cosmetic {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  
  itemCode         String
  itemName         String
  receivedDate     DateTime?
  category         String?
  wholesaler       String?
  quantityReceived Int      @default(0)
  quantityIssued   Int      @default(0)
  lossAdjustment   Int      @default(0)
  currentQuantity  Int      @default(0)
  expireDate       DateTime?
  batchNumber      String?
  purchasePrice    Float    @default(0)
  salePrice        Float    @default(0)
  remark           String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("cosmetics")
}
